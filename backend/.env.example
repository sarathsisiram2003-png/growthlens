# Copy to .env and fill in. Never commit .env.
# Google Cloud project registered for Earth Engine (non-commercial)
EE_PROJECT=
# Optional: path to service-account JSON key. Leave empty to use `earthengine authenticate` login.
EE_SERVICE_ACCOUNT_KEY=
EE_SERVICE_ACCOUNT_EMAIL=
# Contact string put in the User-Agent for Nominatim/Overpass (use an app name or your own contact)
HTTP_USER_AGENT=GrowthLens/0.1 (portfolio project)

# LLM intent parsing (Google Gemini, https://aistudio.google.com/apikey). Empty = offline preset fallback.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
